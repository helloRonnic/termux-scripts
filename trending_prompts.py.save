# trending_prompts.py
# What this script does:
# → Goes to Reddit's top AI art communities
# → Finds the most upvoted posts from this week
# → These posts = trending prompts and ideas people love RIGHT NOW
# → Saves everything to a text file you can use for content

import requests
import json
from datetime import datetime

# ─────────────────────────────────────────────
# SETTINGS — Change these if you want
# ─────────────────────────────────────────────

# These are the Reddit communities we will check
# All are public AI art/prompt communities
SUBREDDITS = [
    "midjourney",
    "StableDiffusion",
    "AIArt",
    "PromptSharing",
# How many trending posts to grab from each community
POSTS_PER_SUB = 5

# Time range: "week" = trending this week (best for content)
# Other options: "day", "month", "year"
TIME_RANGE = "week"

# ─────────────────────────────────────────────
# FUNCTION 1 — Fetch posts from one subreddit
# ─────────────────────────────────────────────

def get_trending_posts(subreddit):
    # Build the URL — Reddit gives us free JSON data from any public page
    url = f"https://www.reddit.com/r/{subreddit}/top.json?limit={POSTS_PER_SUB}&t={TIME_RANGE}"
    
    # Reddit blocks requests without a User-Agent header — this fixes that
    headers = {
        "User-Agent": "TrendingPromptFinder/1.0"
    }
    
    try:
        # Send the request and wait up to 15 seconds for a response
        response = requests.get(url, headers=headers, timeout=15)
        
        # 200 means success, anything else means something went wrong
        if response.status_code == 200:
            data = response.json()
            posts = data["data"]["children"]
            
            # Pull out only the info we actually need
            results = []
            for post in posts:
                p = post["data"]
                results.append({
                    "title": p["title"],
                    "upvotes": p["ups"],
                    "comments": p["num_comments"],
                    "link": f"https://reddit.com{p['permalink']}"
                })
            return results
        
        elif response.status_code == 429:
            # 429 means Reddit is saying "slow down"
            print(f"  ⚠️  r/{subreddit} — Rate limited. Try again in a few minutes.")
            return []
        
        else:
            print(f"  ⚠️  r/{subreddit} — Could not fetch (Status: {response.status_code})")
            return []
    
    except requests.exceptions.ConnectionError:
        print(f"  ❌  r/{subreddit} — No internet connection.")
        return []
    
    except Exception as e:
        print(f"  ❌  r/{subreddit} — Unexpected error: {e}")
        return []

# ─────────────────────────────────────────────
# FUNCTION 2 — Save all results to a text file
# ─────────────────────────────────────────────

def save_to_file(all_results):
    # Name the file with today's date so files don't overwrite each other
    today = datetime.now().strftime("%Y-%m-%d")
    filename = f"prompts_{today}.txt"
    
    with open(filename, "w", encoding="utf-8") as f:
        f.write(f"TRENDING AI IMAGE PROMPTS — {today}\n")
        f.write("Generated by Termux Prompt Finder\n")
        f.write("=" * 55 + "\n\n")
        
        for subreddit, posts in all_results.items():
            f.write(f"[ r/{subreddit} ]\n")
            f.write("-" * 40 + "\n")
            
            for i, post in enumerate(posts, 1):
                f.write(f"{i}. {post['title']}\n")
                f.write(f"   Upvotes: {post['upvotes']}  |  Comments: {post['comments']}\n")
                f.write(f"   Link: {post['link']}\n\n")
            
            f.write("\n")
        
        # Add a content ideas section at the bottom
        f.write("=" * 55 + "\n")
        f.write("CONTENT IDEAS FROM THESE TRENDS\n")
        f.write("=" * 55 + "\n")
        f.write("→ Pick the 3 most upvoted titles above\n")
        f.write("→ Turn each into a YouTube Short or Instagram Reel\n")
        f.write("→ Format: 'I tried the most viral AI prompt this week'\n")
        f.write("→ Use these prompts in your own AI art + post results\n")
    
    return filename

# ─────────────────────────────────────────────
# MAIN — This is where the script actually runs
# ─────────────────────────────────────────────

def main():
    print("\n" + "=" * 55)
    print("  TRENDING AI IMAGE PROMPT FINDER")
    print("  Powered by Termux + Reddit Public Data")
    print("=" * 55)
    print(f"\n  Checking {len(SUBREDDITS)} communities for trending prompts...")
    print(f"  Time range: This {TIME_RANGE}\n")
    
    all_results = {}
    total_posts = 0
    
    # Loop through each subreddit and collect data
    for subreddit in SUBREDDITS:
        print(f"  🔍 Fetching r/{subreddit}...")
        posts = get_trending_posts(subreddit)
        
        if posts:
            all_results[subreddit] = posts
            total_posts += len(posts)
            print(f"  ✅ Got {len(posts)} trending posts\n")
        else:
            print(f"  ⏭️  Skipping r/{subreddit}\n")
    
    # If we got any results, display and save them
    if all_results:
        print("\n" + "=" * 55)
        print("  TOP TRENDING POSTS THIS WEEK")
        print("=" * 55)
        
        for subreddit, posts in all_results.items():
            print(f"\n  📌 r/{subreddit}")
            print("  " + "-" * 40)
            for i, post in enumerate(posts, 1):
                # Trim long titles so they fit on phone screen
                title = post['title'][:70] + "..." if len(post['title']) > 70 else post['title']
                print(f"  {i}. {title}")
                print(f"     👍 {post['upvotes']} upvotes")
        
        # Save everything to a file
        filename = save_to_file(all_results)
        
        print(f"\n" + "=" * 55)
        print(f"  ✅ Done! Found {total_posts} trending posts")
        print(f"  📄 Saved to: {filename}")
        pr# trending_prompts.py
